APP_NAME=Personal AI OS
APP_SECRET=change-this-secret
ADMIN_TOKEN=change-this-admin-token

LLM_PROVIDER=gemini
LLM_FALLBACKS=groq,cloudflare,gemini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_VISION_MODEL=gemini-2.5-flash
GEMINI_AUDIO_MODEL=gemini-2.5-flash

# Vision has its own fallback chain because text-only providers cannot analyze images.
VISION_PROVIDERS=gemini,groq

# Optional fallback provider (also used as vision fallback when configured)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Optional text fallback provider
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct

TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
PUBLIC_BASE_URL=

# Local scheduling / proactive assistant
TIMEZONE=Asia/Kolkata
DAILY_BRIEF_ENABLED=true
DAILY_BRIEF_HOUR=8
DAILY_BRIEF_MINUTE=0

DB_PATH=storage/personal_ai.db
UPLOAD_DIR=storage/uploads
MAX_UPLOAD_MB=20
MEMORY_RESULTS=12
DOCUMENT_RESULTS=8
